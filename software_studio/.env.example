# EmailJS (public keys, safe in the browser). Create them at https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# WhatsApp: the number the green button opens a chat with, digits only with country code (for example 919876543210).
# Leave empty and WhatsApp asks the visitor who to send to.
VITE_WHATSAPP_NUMBER=

# Planner: leave empty to use the built-in rules (free, no network).
# To use a live AI model, set this to the address of a small server endpoint that accepts { "idea": "..." }
# and answers with { "need": "website" | "app" | "both", "type": "...", "screens": [...], "questions": [...] }.
# Keep the AI provider's key on that server, never in this file.
VITE_PLANNER_URL=
