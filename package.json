{
  "name": "studio-site",
  "private": true,
  "version": "0.2.0",
  "description": "Three complete versions of the DuoForge studio site, one per folder.",
  "workspaces": [
    "blender_studio",
    "railway_studio",
    "software_studio"
  ],
  "scripts": {
    "dev:blender": "npm run dev -w blender_studio",
    "dev:railway": "npm run dev -w railway_studio",
    "dev:software": "npm run dev -w software_studio",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "test": "npm run test --workspaces",
    "e2e": "npm run e2e --workspaces"
  }
}
